APP_USER_AGENT=TripPlannerCourseProject/0.1

# Airbnb MCP: 1 (default) starts the server with --ignore-robots-txt (Airbnb disallows search pages); 0 respects robots.txt
AIRBNB_IGNORE_ROBOTS_TXT=1
