# Lehmus AI (University of Oulu LLM API; only reachable from the university network or VPN). The model id is
# GPT OSS 120B. Not needed for the offline demo (DEMO=1).
LEHMUS_API_BASE=https://api.lehmus-ai.oulu.fi/v1
LEHMUS_API_KEY=
LEHMUS_MODEL_ID=azsydsttjnlbfjbgqnwd

# Optional, instead of Lehmus (e.g. off the university network): any LiteLLM model string with its key, e.g.
# LLM_MODEL=openai/gpt-4.1-mini and LLM_API_KEY=sk-... The prompts were tested on GPT OSS 120B only.
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# Data sources: free keys, all optional. Without a key the planner still works with less detail
# (scripts/check_setup.py says what each missing key costs).
# Recommended: web search (opening hours, ticket prices, ferry and bus fares) and sights.
TAVILY_API_KEY=
OPENTRIPMAP_API_KEY=
# Optional: hotel rates, Google Hotels and Google Flights.
LITEAPI_KEY=
SERPAPI_KEY=

# Your e-mail, sent in the User-Agent. Needed in practice: Wikipedia, Wikivoyage and Nominatim block clients
# without a contact address (HTTP 403).
CONTACT_EMAIL=
APP_USER_AGENT=TripPlannerCourseProject/0.1

# Airbnb MCP: 1 (default) starts the server with --ignore-robots-txt (Airbnb disallows search pages); 0 respects robots.txt
AIRBNB_IGNORE_ROBOTS_TXT=1
